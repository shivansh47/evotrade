# Settings
n_steps = 500 # Reduced from 1000 for speed
n_episodes = 5 # Reduced from 20 for speed
window_size = 30
memory_capacity = n_steps * 10
save_path = 'agents_test/'

warnings.filterwarnings("ignore", category=FutureWarning, module="pandas")
pd.set_option('future.no_silent_downcasting', True)

def prepare_data(df):
    df['volume'] = np.int64(df['volume'])
    df['date'] = pd.to_datetime(df['date'])
    df.sort_values(by='date', ascending=True, inplace=True)
    df.reset_index(drop=True, inplace=True)
    return df

def fetch_data():
    print("Fetching data...")
    cdd = CryptoDataDownload()
    bitfinex_data = cdd.fetch("Bitfinex", "USD", "BTC", "1h")
    bitfinex_data = bitfinex_data[['date', 'open', 'high', 'low', 'close', 'volume']]
    return prepare_data(bitfinex_data)

def rsi(price, period):
    r = price.diff()
    upside = r.clip(lower=0)
    downside = -r.clip(upper=0)
    rs = upside.ewm(alpha=1 / period).mean() / downside.ewm(alpha=1 / period).mean()
    return 100*(1 - (1 + rs) ** -1)

def macd(price, fast, slow, signal):
    fm = price.ewm(span=fast, adjust=False).mean()
    sm = price.ewm(span=slow, adjust=False).mean()
    md = fm - sm
    return md - md.ewm(span=signal, adjust=False).mean()

def generate_features(data):
    print("Generating features...")
    df = data.copy()
    ta.add_all_ta_features(df, 'open', 'high', 'low', 'close', 'volume', fillna=True)

    df = df.rename(columns={'open': 'Open', 'high': 'High', 'low': 'Low', 'close': 'Close', 'volume': 'Volume'})
    df = df.set_index('date')

    features = pd.DataFrame.from_dict({
        'prev_close': df['Close'].shift(1),
        'rsi_14': rsi(df['Close'], period=14),
        'macd_normal': macd(df['Close'], 12, 26, 9),
    })
    data = pd.concat([df, features], axis='columns').ffill().dropna()
    data = data.rename(columns={'Open': 'open', 'High': 'high', 'Low': 'low', 'Close': 'close', 'Volume': 'volume'})
    return data.reset_index()

class AnomalousProfit(TensorTradeRewardScheme):
    registered_name = "anomalous"
    def __init__(self, threshold=0.02, window_size=1):
        self._threshold = threshold
    def get_reward(self, portfolio):
        performance = pd.DataFrame.from_dict(portfolio.performance).T
        if performance.shape[0] > 1:
            net_worths = performance['net_worth']
            returns = net_worths.pct_change().fillna(0)
            return 1.0 if returns.iloc[-1] > self._threshold else -1.0
        return 0.0

def main():
    data = fetch_data()
    data = generate_features(data)

    # Split a small chunk for testing
    X_train = data.iloc[:n_steps + window_size].copy()

    # Simple normalization
    cols = [c for c in X_train.columns if c != 'date']
    X_scaled = X_train[cols].copy()
    for c in cols:
        scaler = MinMaxScaler()
        X_scaled[c] = scaler.fit_transform(X_train[[c]]).flatten()

    # Env Setup
    price = Stream.source(list(X_train["close"]), dtype="float").rename("USD-BTC")
    bitstamp = Exchange("bitstamp", service=execute_order)(price)
    cash = Wallet(bitstamp, 50000 * USD)
    asset = Wallet(bitstamp, 0 * BTC)
    portfolio = Portfolio(USD, [cash, asset])

    with NameSpace("bitstamp"):
        features = [Stream.source(list(X_scaled[c]), dtype="float").rename(c) for c in cols]

    feed = DataFeed(features)
    feed.compile()

    env = create_env(
        portfolio=portfolio,
        action_scheme=BSH(cash=cash, asset=asset),
        reward_scheme=AnomalousProfit(),
        feed=feed,
        window_size=window_size
    )

    print("Training Agent...")
    agent = DQNAgent(env)

    # Calculate batch size
    batch_size = ((n_steps - window_size - 1) // 4)

    agent.train(batch_size=batch_size, n_steps=n_steps, n_episodes=n_episodes,
                memory_capacity=memory_capacity, save_path=save_path)

    print("\nTraining Complete!")
    print(f"Final Net Worth: {portfolio.net_worth}")

if __name__ == "__main__":
    main()
